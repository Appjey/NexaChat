# `npm run dev:local` (vite --mode localhost): Vite dev server on :5173 that
# proxies /api, /ws and /uploads to a backend running on the host (IDE run
# config "Backend: go run", or `go run ./cmd/server` with PORT=8080).
# Same-origin through the proxy, so no CORS or mixed-origin WS issues.
VITE_USE_PROXY=true
VITE_PROXY_TARGET=http://localhost:8080
